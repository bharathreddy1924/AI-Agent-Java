# ================================================================
# AI-Powered Intelligent Workflow Agent - Configuration Example
# Copy this file to '.env' or export these environment variables.
# NEVER commit your real '.env' file containing secrets to Git!
# ================================================================

# LLM API Key (OpenAI, Groq, OpenRouter, or Gemini OpenAI-compatible)
# Leave empty to run in built-in offline Simulation / Mock LLM Mode
OPENAI_API_KEY=your_openai_or_compatible_api_key_here

# Base URL for the LLM API endpoint (default: https://api.openai.com/v1)
# Examples:
# - OpenAI: https://api.openai.com/v1
# - Groq: https://api.groq.com/openai/v1
# - Ollama (local): http://localhost:11434/v1
# - Gemini OpenAI-compatible: https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_BASE_URL=https://api.openai.com/v1

# Model Name (default: gpt-3.5-turbo or gpt-4o-mini)
# Examples: gpt-4o-mini, llama-3.1-70b-versatile, mistral-7b
OPENAI_MODEL=gpt-4o-mini

# HTTP Request Timeout in seconds (default: 30)
HTTP_TIMEOUT_SECONDS=30

# Mode override: "auto" (default, detects API key), "live", or "mock"
AGENT_MODE=auto
